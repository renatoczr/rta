---
import Menu from './Menu.astro';
---

<header class="bg-[#121118] border-b border-amber-500/20 sticky top-0 z-30 shadow-md">
  <div class="max-w-6xl mx-auto px-4 h-20 flex items-center justify-between">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 hover:opacity-90 transition-opacity">
      <img src="/logo.webp" alt="RTA Serviços Elétricos" class="h-18 w-auto object-contain" />
    </a>

    <!-- Botão das 3 Barrinhas -->
    <button 
      id="open-menu" 
      aria-label="Abrir Menu" 
      class="p-2.5 text-amber-400 hover:text-amber-300 hover:bg-white/5 rounded-lg transition-all focus:outline-none"
    >
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>
</header>

<Menu />