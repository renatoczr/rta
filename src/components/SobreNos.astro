---
const servicos = [
  {
    titulo: "Instalação de Tomadas e Interruptores",
    descricao: "Dimensionamento correto de fiação e instalação segura de tomadas simples, duplas, de alta potência (20A) e interruptores inteligentes ou paralelos."
  },
  {
    titulo: "Manutenção Elétrica Residencial",
    descricao: "Diagnóstico completo de falhas elétricas, reparo de curtos-circuitos, substituição de fiação antiga e adequação às normas de segurança NBR 5410."
  },
  {
    titulo: "Instalação de Quadros de Energia (QDF)",
    descricao: "Montagem, organização e modernização de quadros de distribuição de circuitos, garantindo equilíbrio de fases e proteção contra sobrecargas."
  },
  {
    titulo: "Troca de Disjuntores e Fusíveis",
    descricao: "Substituição de disjuntores desarmando, ultrapassados ou subdimensionados por dispositivos modernos (DIN) e instalação de DPS e DR para proteção da família."
  },
  {
    titulo: "Serviços Rurais — Fechamento de Chave",
    descricao: "Atendimento especializado para propriedades rurais: manobra, manutenção e fechamento seguro de chaves fusíveis e seccionadoras em redes agrícolas."
  },
  {
    titulo: "Serviços Rurais — Alta Tensão",
    descricao: "Manutenção e instalação em redes de distribuição rurais de alta tensão, alinhamento de postes, pequenos transformadores e infraestrutura de campo."
  },
  {
    titulo: "Serviços Rurais — Baixa Tensão",
    descricao: "Instalação elétrica para currais, galpões, pivôs de irrigação, bombas d'água e residências rurais com cabeamento reforçado."
  },
  {
    titulo: "Instalação de Sistemas de Iluminação",
    descricao: "Projetos de iluminação em LED residenciais, comerciais e industriais: refletores para áreas externas, fitas de LED, lustres e pendentes."
  }
];
---

<section id="sobre" class="w-full max-w-4xl mx-auto px-4 py-12">
  <!-- Apresentação Institucional (Sobre Nós) -->
  <div class="text-center mb-10">
    <span class="text-xs font-semibold text-amber-500 uppercase tracking-widest">Sobre a RTA</span>
    <h2 class="text-2xl md:text-3xl font-bold text-white mt-1">Tradição, Segurança e Eficiência Elétrica</h2>
    <p class="text-gray-300 text-sm md:text-base mt-4 max-w-2xl mx-auto leading-relaxed">
      A <strong>RTA Serviços Elétricos</strong> atua em Paraúna e região oferecendo soluções elétricas completas para residências, comércios e propriedades rurais. Nossa missão é garantir segurança, eficiência energética e tranquilidade para nossos clientes através de um atendimento ágil e profissional.
    </p>
  </div>

  <!-- Accordion de Serviços -->
  <div class="mb-4 text-center">
    <h3 class="text-lg font-semibold text-amber-400">Nossos Serviços Especializados</h3>
    <p class="text-xs text-gray-400">Clique no serviço para ver mais detalhes</p>
  </div>

  <div class="flex flex-col gap-3">
    {servicos.map((servico, index) => (
      <div class="bg-zinc-900/90 border border-zinc-800 rounded-xl overflow-hidden hover:border-amber-500/40 transition-colors">
        <button
          class="accordion-btn w-full p-4 text-left flex justify-between items-center font-medium text-gray-200 hover:text-amber-400 transition-colors focus:outline-none"
          data-target={`accordion-content-${index}`}
        >
          <span class="text-base flex items-center gap-2">
            <span class="text-amber-500">⚡</span>
            {servico.titulo}
          </span>
          <svg
            class="accordion-icon w-5 h-5 text-gray-400 transition-transform duration-300"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <div
          id={`accordion-content-${index}`}
          class="accordion-content max-h-0 overflow-hidden transition-all duration-300 ease-in-out bg-black/20"
        >
          <p class="p-4 pt-1 text-sm text-gray-300 leading-relaxed border-t border-zinc-800/50">
            {servico.descricao}
          </p>
        </div>
      </div>
    ))}
  </div>
</section>

<script>
  const buttons = document.querySelectorAll('.accordion-btn');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const targetId = btn.getAttribute('data-target');
      const content = document.getElementById(targetId!);
      const icon = btn.querySelector('.accordion-icon');

      const isOpen = content?.style.maxHeight && content.style.maxHeight !== '0px';

      // Fecha todos os outros accordions abertos (opcional - mantém o layout limpo)
      document.querySelectorAll('.accordion-content').forEach((el) => {
        (el as HTMLElement).style.maxHeight = '0px';
      });
      document.querySelectorAll('.accordion-icon').forEach((ic) => {
        ic.classList.remove('rotate-180');
      });

      // Se não estava aberto, abre o clicado
      if (!isOpen && content) {
        content.style.maxHeight = content.scrollHeight + 'px';
        icon?.classList.add('rotate-180');
      }
    });
  });
</script>