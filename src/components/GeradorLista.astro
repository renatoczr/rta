---
import config from '../data/config.json';

const categorias = [
  {
    nome: "Condutores e Cabos",
    itens: ["Cabo Flexível 1.5mm²", "Cabo Flexível 2.5mm²", "Cabo Flexível 4.0mm²", "Cabo Flexível 6.0mm²", "Cabo Flexível 10mm²", "Fita Isolante"]
  },
  {
    nome: "Proteção Elétrica",
    itens: ["Disjuntor Monopolar 10A", "Disjuntor Monopolar 16A", "Disjuntor Monopolar 20A", "Disjuntor Bipolar 25A", "Disjuntor Bipolar 32A", "Disjuntor Bipolar 40A", "Dispositivo DR (Diferencial Residual)", "DPS (Protetor de Surtos)"]
  },
  {
    nome: "Interruptores e Tomadas",
    itens: ["Tomada Simples 10A", "Tomada Dupla 10A", "Tomada Específica 20A", "Interruptor Simples 1 Tecla", "Interruptor 2 Teclas", "Interruptor + Tomada"]
  },
  {
    nome: "Infraestrutura e Iluminação",
    itens: ["Eletroduto Flexível Corrugado 3/4\"", "Eletroduto Flexível Corrugado 1\"", "Caixa de Luz 4x2", "Caixa de Luz 4x4", "Lâmpada LED 9W/12W", "Refletor LED 50W/100W"]
  }
];
---

<section id="gerador" class="w-full max-w-4xl mx-auto px-4 py-12">
  <div class="text-center mb-8">
    <span class="text-xs font-semibold text-amber-500 uppercase tracking-widest">Ferramenta Prática</span>
    <h2 class="text-2xl md:text-3xl font-bold text-white mt-1">Gerar Lista de Materiais</h2>
    <p class="text-gray-400 text-sm mt-2 max-w-lg mx-auto">
      Monte sua lista de compras de materiais elétricos e envie diretamente para o nosso WhatsApp para cotação ou validação técnica.
    </p>
  </div>

  <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-4 sm:p-6 shadow-xl">
    <!-- Adicionar item personalizado -->
    <div class="mb-6 pb-6 border-b border-zinc-800 flex flex-col sm:flex-row gap-2">
      <input
        type="text"
        id="item-custom"
        placeholder="Digite outro material (ex: Canaleta 20x10mm)..."
        class="flex-1 bg-black/40 border border-zinc-700 text-white rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-amber-500"
      />
      <button
        id="btn-add-custom"
        class="bg-zinc-800 hover:bg-zinc-700 text-amber-400 border border-amber-500/30 font-semibold px-5 py-3 rounded-xl text-sm transition-all flex items-center justify-center gap-2"
      >
        <span>+ Adicionar À Lista</span>
      </button>
    </div>

    <!-- Lista de Categorias Recomendadas -->
    <div class="space-y-6">
      {categorias.map((cat) => (
        <div>
          <h3 class="text-sm font-semibold text-amber-400 mb-3 uppercase tracking-wider">{cat.nome}</h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
            {cat.itens.map((item) => (
              <div class="flex items-center justify-between bg-black/30 p-2.5 rounded-xl border border-zinc-800/80">
                <span class="text-xs sm:text-sm text-gray-200">{item}</span>
                <div class="flex items-center gap-1.5">
                  <button
                    class="btn-qtd p-1 rounded bg-zinc-800 text-amber-400 hover:bg-zinc-700 w-7 h-7 flex items-center justify-center font-bold"
                    data-action="sub"
                    data-name={item}
                  >-</button>
                  <span class="qtd-val text-xs text-white font-mono w-6 text-center" data-name={item}>0</span>
                  <button
                    class="btn-qtd p-1 rounded bg-zinc-800 text-amber-400 hover:bg-zinc-700 w-7 h-7 flex items-center justify-center font-bold"
                    data-action="add"
                    data-name={item}
                  >+</button>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- Resumo e Envio -->
    <div class="mt-8 pt-6 border-t border-zinc-800 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div>
        <p class="text-xs text-gray-400">Total de itens selecionados:</p>
        <span id="total-itens-count" class="text-xl font-bold text-amber-400">0 itens</span>
      </div>

      <button
        id="btn-enviar-lista"
        data-phone={config.contatos[0].telefone}
        class="w-full sm:w-auto bg-emerald-600 hover:bg-emerald-500 text-white font-bold py-3.5 px-6 rounded-xl shadow-lg transition-all flex items-center justify-center gap-2 active:scale-95"
      >
        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
          <path d="M12.031 2c-5.517 0-9.993 4.476-9.993 9.993 0 1.763.459 3.486 1.332 5.003l-1.417 5.176 5.297-1.389c1.465.8 3.118 1.22 4.781 1.22h.004c5.517 0 9.993-4.476 9.993-9.993 0-2.673-1.041-5.186-2.931-7.076-1.89-1.89-4.403-2.934-7.066-2.934zm0 18.313h-.003c-1.493 0-2.957-.401-4.232-1.157l-.304-.18-3.146.825.839-3.067-.198-.315c-.832-1.323-1.272-2.859-1.272-4.426 0-4.593 3.737-8.33 8.332-8.33 2.225 0 4.316.867 5.889 2.441 1.573 1.574 2.439 3.665 2.439 5.89 0 4.594-3.737 8.33-8.334 8.33z"/>
        </svg>
        <span>Enviar Lista no WhatsApp</span>
      </button>
    </div>
  </div>
</section>

<script>
  interface ListaItem {
    nome: string;
    qtd: number;
  }

  const itensLista: Record<string, number> = {};

  const btnQtds = document.querySelectorAll('.btn-qtd');
  const customInput = document.getElementById('item-custom') as HTMLInputElement;
  const btnAddCustom = document.getElementById('btn-add-custom');
  const btnEnviar = document.getElementById('btn-enviar-lista');
  const totalCountEl = document.getElementById('total-itens-count');

  function atualizarInterface() {
    let totalUnidades = 0;

    Object.entries(itensLista).forEach(([nome, qtd]) => {
      totalUnidades += qtd;
      const spanQtd = document.querySelector(`.qtd-val[data-name="${CSS.escape(nome)}"]`);
      if (spanQtd) spanQtd.textContent = String(qtd);
    });

    if (totalCountEl) {
      totalCountEl.textContent = `${totalUnidades} item(ns)`;
    }
  }

  btnQtds.forEach((btn) => {
    btn.addEventListener('click', () => {
      const name = btn.getAttribute('data-name');
      const action = btn.getAttribute('data-action');
      if (!name) return;

      const atual = itensLista[name] || 0;
      if (action === 'add') {
        itensLista[name] = atual + 1;
      } else if (action === 'sub' && atual > 0) {
        itensLista[name] = atual - 1;
      }

      atualizarInterface();
    });
  });

  btnAddCustom?.addEventListener('click', () => {
    const valor = customInput?.value.trim();
    if (valor) {
      itensLista[valor] = (itensLista[valor] || 0) + 1;
      customInput.value = '';
      alert(`Item "${valor}" adicionado!`);
      atualizarInterface();
    }
  });

  btnEnviar?.addEventListener('click', () => {
    const telefone = btnEnviar.getAttribute('data-phone');
    const selecionados = Object.entries(itensLista).filter(([_, qtd]) => qtd > 0);

    if (selecionados.length === 0) {
      alert('Por favor, adicione pelo menos 1 item à sua lista antes de enviar.');
      return;
    }

    let texto = "Olá! Gostaria de um orçamento para a seguinte lista de materiais:\n\n";
    selecionados.forEach(([nome, qtd]) => {
      texto += `• ${nome}: ${qtd}x\n`;
    });

    const url = `https://wa.me/${telefone}?text=${encodeURIComponent(texto)}`;
    window.open(url, '_blank');
  });
</script>