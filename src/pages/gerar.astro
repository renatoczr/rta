---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Rodape from '../components/Rodape.astro';
---

<Layout title="Gerar Lista de Materiais — RTA Serviços Elétricos">
  <Header />

  <main class="flex-1 bg-[#121118] text-white py-10 px-4">
    <div class="max-w-2xl mx-auto bg-zinc-900 border border-zinc-800 rounded-2xl p-6 shadow-xl">
      <h1 class="text-2xl font-bold text-amber-400 mb-6">Lista de Materiais</h1>

      <form id="form-lista" class="flex flex-col gap-4">
        <div>
          <label class="block text-xs font-semibold text-gray-400 uppercase mb-1">Nome do Cliente</label>
          <input
            type="text"
            id="cliente-nome"
            required
            placeholder="Digite o nome completo"
            class="w-full bg-black/40 border border-zinc-700 text-white rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-amber-500"
          />
        </div>

        <div>
          <label class="block text-xs font-semibold text-gray-400 uppercase mb-1">Telefone</label>
          <input
            type="tel"
            id="cliente-fone"
            required
            placeholder="(64) 99999-9999"
            class="w-full bg-black/40 border border-zinc-700 text-white rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-amber-500"
          />
        </div>

        <div class="mt-2">
          <label class="block text-xs font-semibold text-gray-400 uppercase mb-2">Itens do Orçamento</label>
          <div id="container-linhas" class="flex flex-col gap-3">
            <!-- Primeira linha padrão -->
            <div class="flex gap-2 item-linha">
              <input
                type="text"
                placeholder="Qtd"
                class="item-qtd w-20 bg-black/40 border border-zinc-700 text-white rounded-xl px-3 py-3 text-sm text-center focus:outline-none focus:border-amber-500"
                required
              />
              <input
                type="text"
                placeholder="Descrição (ex: Disjuntor 20A DIN)"
                class="item-desc flex-1 bg-black/40 border border-zinc-700 text-white rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-amber-500"
                required
              />
              <button
                type="button"
                class="btn-remove-linha bg-red-500/10 hover:bg-red-500/20 text-red-400 p-3 rounded-xl transition-colors border border-red-500/20"
                title="Remover linha"
              >
                ✕
              </button>
            </div>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row gap-3 mt-4">
          <button
            type="button"
            id="btn-add-linha"
            class="bg-blue-600 hover:bg-blue-500 text-white font-semibold px-5 py-3 rounded-xl text-sm transition-all shadow-md"
          >
            Adicionar Linha
          </button>

          <button
            type="submit"
            class="flex-1 bg-emerald-600 hover:bg-emerald-500 text-white font-bold py-3.5 px-6 rounded-xl shadow-lg transition-all text-center"
          >
            Gerar e Visualizar Lista
          </button>
        </div>
      </form>
    </div>
  </main>

  <Rodape />
</Layout>
<script>
  const container = document.getElementById('container-linhas');
  const btnAdd = document.getElementById('btn-add-linha');
  const form = document.getElementById('form-lista') as HTMLFormElement;

  function criarNovaLinha() {
    const div = document.createElement('div');
    div.className = 'flex gap-2 item-linha';
    div.innerHTML = `
      <input
        type="text"
        placeholder="Qtd"
        class="item-qtd w-20 bg-black/40 border border-zinc-700 text-white rounded-xl px-3 py-3 text-sm text-center focus:outline-none focus:border-amber-500"
        required
      />
      <input
        type="text"
        placeholder="Descrição do material"
        class="item-desc flex-1 bg-black/40 border border-zinc-700 text-white rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-amber-500"
        required
      />
      <button
        type="button"
        class="btn-remove-linha bg-red-500/10 hover:bg-red-500/20 text-red-400 p-3 rounded-xl transition-colors border border-red-500/20"
      >
        ✕
      </button>
    `;

    div.querySelector('.btn-remove-linha')?.addEventListener('click', () => {
      if (document.querySelectorAll('.item-linha').length > 1) {
        div.remove();
      }
    });

    container?.appendChild(div);
  }

  btnAdd?.addEventListener('click', criarNovaLinha);

  document.querySelector('.btn-remove-linha')?.addEventListener('click', (e) => {
    if (document.querySelectorAll('.item-linha').length > 1) {
      (e.target as HTMLElement).closest('.item-linha')?.remove();
    }
  });

  form?.addEventListener('submit', (e) => {
    e.preventDefault();

    const nome = (document.getElementById('cliente-nome') as HTMLInputElement).value;
    const fone = (document.getElementById('cliente-fone') as HTMLInputElement).value;
    const linhas = document.querySelectorAll('.item-linha');

    const itens: Array<{ qtd: string; desc: string }> = [];
    linhas.forEach((linha) => {
      const qtd = (linha.querySelector('.item-qtd') as HTMLInputElement).value;
      const desc = (linha.querySelector('.item-desc') as HTMLInputElement).value;
      if (qtd && desc) itens.push({ qtd, desc });
    });

    // Criar um ID único baseado no timestamp
    const idLista = 'rta_' + Date.now();
    const dadosObj = { id: idLista, nome, fone, itens, data: new Date().toLocaleDateString('pt-BR') };

    // Salva o JSON indexado pelo ID
    localStorage.setItem(`rta_lista_${idLista}`, JSON.stringify(dadosObj));

    // Redireciona com a URL limpa contendo o ID
    window.location.href = `/lista?id=${idLista}`;
  });
</script>