---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Rodape from '../components/Rodape.astro';
---

<Layout title="Lista de Materiais — RTA Serviços Elétricos">
  <Header />

  <main class="flex-1 bg-[#121118] text-white py-10 px-4">
    <div class="max-w-2xl mx-auto bg-zinc-900 border border-zinc-800 rounded-2xl p-6 shadow-xl">
      <div id="status-carregando" class="text-center py-10 text-gray-400">
        Carregando lista de materiais...
      </div>

      <div id="status-erro" class="hidden text-center py-10 text-red-400"></div>

      <div id="conteudo-lista" class="hidden">
        <div class="flex justify-between items-start mb-6 border-b border-zinc-800 pb-4">
          <div>
            <h1 class="text-2xl font-bold text-amber-400">Lista de Materiais</h1>
            <p id="cliente-info" class="text-sm text-gray-300 mt-1"></p>
          </div>
          <span id="data-lista" class="text-xs text-gray-400 bg-zinc-800 px-3 py-1 rounded-full"></span>
        </div>

        <div class="overflow-x-auto mb-6">
          <table class="w-full text-left text-sm border-collapse">
            <thead>
              <tr class="border-b border-zinc-700 text-amber-400 uppercase text-xs">
                <th class="py-2 px-3 w-16">Qtd</th>
                <th class="py-2 px-3">Descrição do Material</th>
              </tr>
            </thead>
            <tbody id="tabela-itens" class="divide-y divide-zinc-800"></tbody>
          </table>
        </div>

        <!-- Painel de Ações Rápidas -->
        <div class="flex flex-col gap-3 print:hidden">
          <button
            id="btn-whatsapp"
            class="w-full bg-emerald-600 hover:bg-emerald-500 text-white font-bold py-3.5 px-4 rounded-xl text-sm transition-all flex items-center justify-center gap-2 shadow-lg"
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M12.012 2c-5.506 0-9.989 4.478-9.99 9.984 0 1.762.459 3.48 1.332 5.001L2 22l5.124-1.334c1.472.802 3.136 1.224 4.884 1.224 5.508 0 9.99-4.478 9.99-9.984 0-2.665-1.037-5.17-2.925-7.059A9.92 9.92 0 0 0 12.012 2z"/>
            </svg>
            Enviar no WhatsApp do Cliente
          </button>

          <div class="grid grid-cols-3 gap-2">
            <button
              id="btn-copiar"
              class="bg-zinc-800 hover:bg-zinc-700 text-white font-medium py-3 px-3 rounded-xl text-xs transition-all text-center"
            >
              Copiar Link
            </button>
            <button
              id="btn-imprimir"
              class="bg-zinc-800 hover:bg-zinc-700 text-white font-medium py-3 px-3 rounded-xl text-xs transition-all text-center"
            >
              Imprimir / PDF
            </button>
            <a
              href="/"
              class="bg-zinc-800 hover:bg-zinc-700 text-red-400 font-semibold py-3 px-3 rounded-xl text-xs transition-all text-center flex items-center justify-center border border-red-500/20"
            >
              Fechar
            </a>
          </div>
        </div>
      </div>
    </div>
  </main>

  <Rodape />
</Layout>

<script>
  const params = new URLSearchParams(window.location.search);
  const id = params.get('id');

  const elCarregando = document.getElementById('status-carregando');
  const elErro = document.getElementById('status-erro');
  const elConteudo = document.getElementById('conteudo-lista');
  const elClienteInfo = document.getElementById('cliente-info');
  const elData = document.getElementById('data-lista');
  const elTabela = document.getElementById('tabela-itens');
  
  const btnWhatsapp = document.getElementById('btn-whatsapp');
  const btnCopiar = document.getElementById('btn-copiar');
  const btnImprimir = document.getElementById('btn-imprimir');

  if (!id) {
    if (elCarregando) elCarregando.classList.add('hidden');
    if (elErro) {
      elErro.textContent = 'Nenhum código de lista foi fornecido na URL.';
      elErro.classList.remove('hidden');
    }
  } else {
    fetch(`/api/buscar?id=${id}`)
      .then((res) => res.json())
      .then((dados) => {
        if (dados.error) {
          if (elCarregando) elCarregando.classList.add('hidden');
          if (elErro) {
            elErro.textContent = dados.error;
            elErro.classList.remove('hidden');
          }
          return;
        }

        if (elClienteInfo) elClienteInfo.innerHTML = `<strong>Cliente:</strong> ${dados.nome} (${dados.fone})`;
        if (elData) elData.textContent = dados.data;

        if (elTabela && Array.isArray(dados.itens)) {
          elTabela.innerHTML = dados.itens
            .map(
              (item: { qtd: string; desc: string }) => `
              <tr>
                <td class="py-3 px-3 font-semibold text-amber-400">${item.qtd}</td>
                <td class="py-3 px-3 text-gray-200">${item.desc}</td>
              </tr>
            `
            )
            .join('');
        }

        if (elCarregando) elCarregando.classList.add('hidden');
        if (elConteudo) elConteudo.classList.remove('hidden');

        // Ação: Botão WhatsApp (com mensagem simplificada)
        btnWhatsapp?.addEventListener('click', () => {
          const foneLimpo = dados.fone.replace(/\D/g, '');
          const linkLista = window.location.href;
          
          const mensagemTexto = `*Lista de Materiais — RTA Serviços Elétricos*\nCliente: ${dados.nome}\nData: ${dados.data}\n\nVisualizar online:\n${linkLista}`;
          const mensagem = encodeURIComponent(mensagemTexto);
          
          const urlWhatsapp = foneLimpo 
            ? `https://wa.me/55${foneLimpo}?text=${mensagem}`
            : `https://wa.me/?text=${mensagem}`;
            
          window.open(urlWhatsapp, '_blank');
        });

        // Ação: Botão Copiar Link
        btnCopiar?.addEventListener('click', () => {
          navigator.clipboard.writeText(window.location.href);
          alert('Link da lista copiado para a área de transferência!');
        });

        // Ação: Botão Imprimir
        btnImprimir?.addEventListener('click', () => {
          window.print();
        });
      })
      .catch(() => {
        if (elCarregando) elCarregando.classList.add('hidden');
        if (elErro) {
          elErro.textContent = 'Erro ao carregar os dados do servidor.';
          elErro.classList.remove('hidden');
        }
      });
  }
</script>