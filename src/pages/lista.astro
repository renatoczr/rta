---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Rodape from '../components/Rodape.astro';

// Pega o ID passado na URL (ex: /lista?id=rta_123456)
const id = Astro.url.searchParams.get('id');

let lista = null;
let erro = null;

if (id) {
  try {
    const runtime = (Astro.locals as any).runtime;
    const LISTAS_KV = runtime?.env?.LISTAS_KV;

    if (LISTAS_KV) {
      const dadosStr = await LISTAS_KV.get(id);
      if (dadosStr) {
        lista = JSON.parse(dadosStr);
      } else {
        erro = 'Lista não encontrada ou expirada.';
      }
    } else {
      erro = 'Conexão com o KV não configurada.';
    }
  } catch (e) {
    erro = 'Erro ao carregar a lista do servidor.';
  }
} else {
  erro = 'Nenhum ID de lista foi informado.';
}
---

<Layout title="Visualizar Lista — RTA Serviços Elétricos">
  <Header />

  <main class="flex-1 bg-[#121118] text-white py-10 px-4">
    <div class="max-w-2xl mx-auto bg-zinc-900 border border-zinc-800 rounded-2xl p-6 shadow-xl">
      {erro ? (
        <div class="text-center py-8">
          <p class="text-red-400 font-semibold text-lg mb-4">{erro}</p>
          <a href="/gerar" class="inline-block bg-amber-500 hover:bg-amber-400 text-black font-bold px-6 py-3 rounded-xl transition-all">
            Criar uma Nova Lista
          </a>
        </div>
      ) : (
        <div>
          <div class="border-b border-zinc-800 pb-4 mb-6 flex flex-col sm:flex-row justify-between sm:items-center gap-2">
            <div>
              <h1 class="text-2xl font-bold text-amber-400">Lista de Materiais</h1>
              <p class="text-sm text-gray-400">Cliente: <strong class="text-white">{lista.nome}</strong></p>
              <p class="text-sm text-gray-400">Contato: <strong class="text-white">{lista.fone}</strong></p>
            </div>
            <span class="text-xs text-gray-500 bg-black/40 px-3 py-1.5 rounded-lg border border-zinc-800 self-start sm:self-auto">
              Gerado em: {lista.data}
            </span>
          </div>

          <!-- Tabela / Lista de Itens -->
          <div class="space-y-2 mb-6">
            <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2">Itens Solicitados</p>
            {lista.itens.map((item: any) => (
              <div class="flex items-center gap-3 bg-black/40 border border-zinc-800 p-3 rounded-xl">
                <span class="bg-amber-500/10 text-amber-400 font-mono font-bold text-xs px-2.5 py-1 rounded-md border border-amber-500/20">
                  {item.qtd}x
                </span>
                <span class="text-sm text-gray-200 flex-1">{item.desc}</span>
              </div>
            ))}
          </div>

          <!-- Ações e Compartilhamento -->
          <div class="flex flex-col sm:flex-row gap-3 pt-4 border-t border-zinc-800">
            <button
              id="btn-copiar"
              class="flex-1 bg-amber-500 hover:bg-amber-400 text-black font-bold py-3.5 px-4 rounded-xl transition-all text-center text-sm"
            >
              Copiar Link para Compartilhar
            </button>

            <a
              href="/gerar"
              class="bg-zinc-800 hover:bg-zinc-700 text-white font-semibold py-3.5 px-5 rounded-xl transition-all text-center text-sm"
            >
              Nova Lista
            </a>
          </div>
        </div>
      )}
    </div>
  </main>

  <Rodape />
</Layout>

<script>
  const btnCopiar = document.getElementById('btn-copiar');

  btnCopiar?.addEventListener('click', () => {
    navigator.clipboard.writeText(window.location.href);
    btnCopiar.innerText = '✓ Link Copiado!';
    setTimeout(() => {
      btnCopiar.innerText = 'Copiar Link para Compartilhar';
    }, 3000);
  });
</script>