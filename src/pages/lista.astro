---
import Layout from '../layouts/Layout.astro';
import config from '../data/config.json';
---

<Layout title="Lista de Materiais — RTA Serviços Elétricos">
  <!-- Barra Superior de Ações (Oculta na Impressão) -->
  <div class="fixed top-0 left-0 right-0 bg-zinc-900/95 backdrop-blur border-b border-zinc-800 p-3 z-50 print:hidden shadow-xl">
    <div class="max-w-3xl mx-auto flex flex-wrap items-center justify-between gap-2">
      <!-- Botão Fechar (Abre a Home) -->
      <a
        href="/"
        class="bg-zinc-800 hover:bg-zinc-700 text-gray-300 hover:text-white font-medium text-xs sm:text-sm px-3.5 py-2 rounded-xl transition-colors border border-zinc-700 flex items-center gap-1.5"
      >
        <span>✕</span>
        <span>Fechar</span>
      </a>

      <!-- Ações Principais -->
      <div class="flex items-center gap-2">
        <button
          id="btn-whatsapp"
          data-phone={config.contatos[0].telefone}
          class="bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-xs sm:text-sm px-4 py-2 rounded-xl transition-all shadow-md flex items-center gap-2 cursor-pointer"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M12.031 2c-5.517 0-9.993 4.476-9.993 9.993 0 1.763.459 3.486 1.332 5.003l-1.417 5.176 5.297-1.389c1.465.8 3.118 1.22 4.781 1.22h.004c5.517 0 9.993-4.476 9.993-9.993 0-2.673-1.041-5.186-2.931-7.076-1.89-1.89-4.403-2.934-7.066-2.934zm0 18.313h-.003c-1.493 0-2.957-.401-4.232-1.157l-.304-.18-3.146.825.839-3.067-.198-.315c-.832-1.323-1.272-2.859-1.272-4.426 0-4.593 3.737-8.33 8.332-8.33 2.225 0 4.316.867 5.889 2.441 1.573 1.574 2.439 3.665 2.439 5.89 0 4.594-3.737 8.33-8.334 8.33z"/>
          </svg>
          <span>Enviar pelo WhatsApp</span>
        </button>

        <button
          onclick="window.print()"
          class="bg-amber-500 hover:bg-amber-400 text-black font-bold text-xs sm:text-sm px-4 py-2 rounded-xl transition-all shadow-md flex items-center gap-1.5 cursor-pointer"
        >
          <span>🖨️</span>
          <span>Imprimir / Salvar PDF</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Documento Timbrado -->
  <main class="min-h-screen bg-zinc-950 text-gray-900 pt-20 pb-8 px-4 sm:px-8 flex justify-center print:p-0 print:bg-white">
    <div class="w-full max-w-3xl bg-white rounded-2xl p-8 sm:p-12 shadow-2xl border border-gray-200 flex flex-col justify-between min-h-[90vh] print:shadow-none print:border-none print:p-0 print:w-full print:min-h-screen">
      <div>
        <!-- Cabeçalho Timbrado RTA -->
        <header class="flex justify-between items-center border-b-2 border-amber-500 pb-6 mb-8">
          <div>
            <img src="/logo.webp" alt="RTA Serviços Elétricos" class="h-16 w-auto object-contain" />
          </div>
          <div class="text-right text-xs text-gray-600">
            <p class="font-bold text-gray-900 text-sm">{config.empresa.nome}</p>
            <p>CNPJ: {config.empresa.cnpj}</p>
            <p>{config.empresa.endereco}</p>
            <p class="text-amber-600 font-semibold mt-1">Lista de Materiais Solicitados</p>
          </div>
        </header>

        <!-- Dados do Cliente -->
        <div class="bg-gray-50 border border-gray-200 rounded-xl p-4 mb-6 grid grid-cols-2 sm:grid-cols-3 gap-4 text-sm">
          <div>
            <span class="text-xs text-gray-500 uppercase font-semibold block">Cliente</span>
            <span id="out-nome" class="font-bold text-gray-800 text-base">-</span>
          </div>
          <div>
            <span class="text-xs text-gray-500 uppercase font-semibold block">Telefone</span>
            <span id="out-fone" class="font-medium text-gray-800">-</span>
          </div>
          <div>
            <span class="text-xs text-gray-500 uppercase font-semibold block">Data</span>
            <span id="out-data" class="font-medium text-gray-800">-</span>
          </div>
        </div>

        <!-- Tabela de Itens -->
        <table class="w-full text-left border-collapse mb-8">
          <thead>
            <tr class="border-b-2 border-gray-300 bg-gray-100 text-xs font-bold text-gray-700 uppercase">
              <th class="py-3 px-4 w-24 text-center">Qtd</th>
              <th class="py-3 px-4">Descrição do Material</th>
            </tr>
          </thead>
          <tbody id="out-tabela" class="divide-y divide-gray-200 text-sm">
            <!-- Linhas inseridas via JS -->
          </tbody>
        </table>
      </div>

      <!-- Rodapé Timbrado com Eleva Sites -->
      <footer class="pt-6 border-t border-gray-200 text-xs text-gray-500 flex justify-between items-center">
        <div>
          <p class="font-semibold text-gray-700">{config.empresa.nome}</p>
          <p>Paraúna - GO e Região</p>
        </div>
        <div class="flex items-center gap-1.5 text-gray-400">
          <span>Criado por</span>
          <img src="/eleva.webp" alt="Eleva Sites" class="h-4 w-auto object-contain" />
        </div>
      </footer>
    </div>
  </main>
</Layout>

<script>
  // Pega o id da URL (?id=rta_...)
  const urlParams = new URLSearchParams(window.location.search);
  const idLista = urlParams.get('id');

  const rawData = idLista ? localStorage.getItem(`rta_lista_${idLista}`) : null;

  if (!rawData) {
    alert('Lista de materiais não encontrada ou expirada.');
    window.location.href = '/gerar';
  } else {
    const dados = JSON.parse(rawData);

    // Preenche a tela
    document.getElementById('out-nome')!.textContent = dados.nome;
    document.getElementById('out-fone')!.textContent = dados.fone;
    document.getElementById('out-data')!.textContent = dados.data;

    const tabela = document.getElementById('out-tabela');
    if (tabela) {
      dados.itens.forEach((item: { qtd: string; desc: string }, index: number) => {
        const tr = document.createElement('tr');
        tr.className = index % 2 === 0 ? 'bg-white' : 'bg-gray-50/50';
        tr.innerHTML = `
          <td class="py-3 px-4 text-center font-bold text-amber-600 border-r border-gray-100">${item.qtd}</td>
          <td class="py-3 px-4 text-gray-800">${item.desc}</td>
        `;
        tabela.appendChild(tr);
      });
    }

    // Botão de Envio via WhatsApp enviando apenas a URL da lista
    const btnWhats = document.getElementById('btn-whatsapp');
    btnWhats?.addEventListener('click', () => {
      const telefone = btnWhats.getAttribute('data-phone');
      const urlLista = window.location.href; // Ex: https://seusite.com.br/lista?id=rta_170000000

      const mensagem = `Olá! Segue a lista de materiais do cliente *${dados.nome}*:\n\n${urlLista}`;
      const linkWhatsApp = `https://wa.me/${telefone}?text=${encodeURIComponent(mensagem)}`;
      
      window.open(linkWhatsApp, '_blank');
    });
  }
</script>